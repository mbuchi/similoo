{
  "name": "similoo",
  "private": true,
  "version": "0.58.3",
  "type": "module",
  "description": "similoo - comparable-buildings explorer: find buildings comparable to a Swiss address (same municipality and zone, recent construction) and inspect them as LOD 2.5 cubes plus a streamed swissSURFACE3D point-cloud detail view (Giro3D).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbuchi/similoo.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run && npm run test:contract",
    "test:contract": "node --test 'test/**/*.test.mjs'",
    "test:mobile-touch": "node scripts/mobile-touch-regression.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aireon/shared": "github:mbuchi/aireon-shared#v1.209.0",
    "@giro3d/giro3d": "^2.0.3",
    "@openreplay/tracker": "^18.1.2",
    "html-to-image": "^1.11.13",
    "lucide": "^0.358.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.3.0",
    "oidc-client-ts": "^3.5.0",
    "ol": "^10.10.0",
    "proj4": "^2.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.180.0"
  }
}
